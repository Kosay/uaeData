## Solve using ode (General Solver for Ordinary Differential Equations)
out <- ode(y = initial_states, times = time, func = disease_model, parms = parameters)
## change to data frame
out_df <- as.data.frame(out)
# Rename columns explicitly for clarity
colnames(out_df) <- c(
"time",
"S_c", "I_c", "R_c",
"S_ym", "I_ym", "R_ym",
"S_yw", "I_yw", "R_yw",
"S_o", "I_o", "R_o"
)
out_df$I_total <- out_df$I_c + out_df$I_ym + out_df$I_yw + out_df$I_o
out_df$S_total <- out_df$S_c + out_df$S_ym + out_df$S_yw + out_df$S_o
out_df$R_total <- out_df$R_c + out_df$R_ym + out_df$R_yw + out_df$R_o
out_df
# Plot total values over time
p_total <- ggplot(out_df, aes(time)) +
geom_line(aes(y = I_total, color="I_total")) +
geom_line(aes(y = S_total, color="S_total")) +
geom_line(aes(y = R_total, color="R_total")) +
labs(title="Total Values Over Time", color="Compartment", x="Time", y="Proportion")
## Plot
matplot(x = time, y = out_df, type = "l",
xlab = "Time", ylab = "Susceptible and Recovered",
main = "SIR Model",
lwd = 1, lty = 1, bty = "l", col = 2:4)
## Add legend
legend(25, 0.7, c("Susceptible", "Infected", "Recovered"), pch = 1, col = 2:4, bty = "n")
## Delete time variable
out_df$time <- NULL
# Plot total values over time
p_total <- ggplot(out_df, aes(time)) +
geom_line(aes(y = I_total, color="I_total")) +
geom_line(aes(y = S_total, color="S_total")) +
geom_line(aes(y = R_total, color="R_total")) +
labs(title="Total Values Over Time", color="Compartment", x="Time", y="Proportion")
## Plot
matplot(x = time, y = out_df, type = "l",
xlab = "Time", ylab = "Susceptible and Recovered",
main = "SIR Model",
lwd = 1, lty = 1, bty = "l", col = 2:4)
## Add legend
legend(25, 0.7, c("Susceptible", "Infected", "Recovered"), pch = 1, col = 2:4, bty = "n")
